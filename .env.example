# Non-secret local orchestration defaults.
BREV_INSTANCE_NAME=robotics-isaac-mvp
BREV_LAUNCHABLE_ID=env-35JP2ywERLgqtD0b0MIeK1HnF46
BREV_INSTANCE_TYPE=g6.4xlarge

# Provisioning fails closed unless these are supplied explicitly for a session.
BREV_COST_APPROVED=
BREV_REGION_CONFIRMED=

# Canonical Phase 1 task. Phase 0 also exercised the separate Direct task.
ISAAC_TASK=Isaac-Cartpole-v0
ISAAC_RL_LIBRARY=skrl
ISAAC_TRAIN_SEED=42
ISAAC_NUM_ENVS=4096
# Empty means use the task's installed official PPO training horizon.
ISAAC_MAX_ITERATIONS=
ISAAC_CHECKPOINT=

PROJECT_GIT_BRANCH=main

# Optional observability controls. Command logs should stay under ignored
# artifacts/ and must never contain credentials.
REMOTE_TRACE=0
REMOTE_DRY_RUN=0
REMOTE_COMMAND_LOG=
